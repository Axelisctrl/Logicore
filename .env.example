# Copy this file to .env and fill it in. Never commit .env.
PROVIDER=anthropic            # anthropic | openai (openai also covers DeepSeek and other OpenAI-compatible APIs)
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1     # e.g. https://api.deepseek.com/v1
# MODEL=claude-sonnet-5-5
PORT=3000
# ACCESS_CODE=choose-a-code       # optional: visitors must enter this code to use the app
# RATE_LIMIT_PER_MIN=30           # requests per IP per minute
# TRUST_PROXY=1                   # set when behind a reverse proxy (Render, Railway, Nginx)
